APP_NAME=HackFire Gateway
APP_ENV=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# Add your Rubika bot token locally. Never commit the real value.
RUBIKA_BOT_TOKEN=

# Optional API credentials. Keep secrets out of Git.
GITHUB_TOKEN=
YOUTUBE_API_KEY=
CURSEFORGE_API_KEY=

DATABASE_URL=sqlite+aiosqlite:///./data/gateway.db
DOWNLOAD_DIR=./data/downloads
MAX_CONCURRENT_DOWNLOADS=2
MAX_DOWNLOAD_SIZE_MB=512
DOWNLOAD_ORPHAN_MAX_AGE_SECONDS=3600
DOWNLOAD_COOLDOWN_SECONDS=15
MAX_ACTIVE_HANDLERS=8
